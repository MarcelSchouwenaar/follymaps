---
layout: layouts/base.njk
---
<article class="location">
  <header class="location-header">
    <h1>{{ title }}</h1>
    {% if description %}
      <p class="location-description">{{ description }}</p>
    {% endif %}
    
    {% if location %}
      <div class="location-info">
        {% if location.name %}
          <p class="location-name"><strong>{{ location.name }}</strong></p>
        {% endif %}
        {% if location.address %}
          <p class="location-address">📍 {{ location.address }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
    
    {% if tags %}
      <div class="location-tags">
        {% for tag in tags %}
          <a href="/tags/{{ tag | slugify }}/" class="tag">#{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  {% if location and location.latitude and location.longitude %}
    <div class="location-map">
      <!-- Map will be inserted here via JavaScript -->
      <div id="map" style="height: 300px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin: 2rem 0;">
        <p>🗺️ Map: {{ location.name or "Location" }} ({{ location.latitude }}, {{ location.longitude }})</p>
      </div>
    </div>
  {% endif %}

  <div class="location-content">
    {{ content | safe }}
  </div>
  
  {% if page.url %}
    <hr>
    <p>
      <a href="/">← Back to all locations</a>
    </p>
  {% endif %}
</article>